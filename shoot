#!/usr/bin/env bash
# shoot — run the extension in a nested shell on a virtual display and
# photograph it. Usage: shoot <outprefix> [gdbus-method-and-args ...]
#
# Without this the only feedback available is "did it throw an exception",
# which says nothing about whether the thing looks right.
set -uo pipefail

OUT="$1"; shift
DISP=":${DISP_NUM:-77}"
W=${W:-1280}; H=${H:-800}

Xvfb "$DISP" -screen 0 "${W}x${H}x24" > /dev/null 2>&1 &
XPID=$!
sleep 3

# A nested mutter ignores the host screen size and comes up 800x600 unless it
# is given a mode spec, which makes screenshots too small to be useful.
env -u WAYLAND_DISPLAY DISPLAY="$DISP" MUTTER_DEBUG_DUMMY_MODE_SPECS="${W}x${H}" \
  dbus-run-session -- bash -c '
  gnome-shell --nested --wayland > /tmp/shoot-shell.log 2>&1 &
  sleep 20
  OBJ=/org/gnome/shell/extensions/topknot
  IF=org.gnome.Shell.Extensions.Topknot
  if [ $# -gt 0 ]; then
    gdbus call --session --dest org.gnome.Shell --object-path $OBJ \
      --method "$IF.$1" "${@:2}" > /dev/null 2>&1
  fi
  for i in 1 2 3 4; do
    DISPLAY='"$DISP"' import -window root "'"$OUT"'-$i.png" 2>/dev/null
    sleep 0.7
  done
' _ "$@" > /dev/null 2>&1 &
SPID=$!

sleep 42
kill $SPID 2>/dev/null
sleep 1
kill $XPID 2>/dev/null
sleep 1
ls -1 "${OUT}"-*.png 2>/dev/null | sed 's/^/  captured /'
